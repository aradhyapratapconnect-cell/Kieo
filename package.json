{
  "name": "kieo",
  "version": "0.0.1",
  "description": "Kieo — local-first, open-source AI desktop assistant (Electron + React + Vercel AI SDK + MCP)",
  "main": "./out/main/main.js",
  "author": "Kieo contributors",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.1.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "20.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.2.0",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.0"
  }
}
